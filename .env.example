# ===== 火山方舟（豆包）大模型 =====
ARK_API_KEY=你的方舟_API_Key
ARK_MODEL=ep-xxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 语音接口（ASR / TTS） =====
# 模式：auto(默认，优先 openspeech)、openspeech、ark
SPEECH_PROVIDER=auto
SPEECH_BASE_URL=https://openspeech.bytedance.com
SPEECH_APPID=
SPEECH_TOKEN=
SPEECH_CLUSTER=volcano_tts

# ===== 服务运行 =====
HOST=0.0.0.0
PORT=8000

# ===== 访问控制（可选，公网暴露时强烈建议开启） =====
# 留空则不启用；设置后，除 /、/static、/api/health 外的接口
# 均需在请求头携带：Authorization: Bearer <ACCESS_TOKEN> 或 X-Access-Token
ACCESS_TOKEN=

# ===== 上传 / TTS 限额 =====
MAX_UPLOAD_MB=50
MAX_AUDIO_MB=25
TTS_VOICE=zh_female_cancan_mars_bigtts
TTS_RATE=1.0
TTS_MAX_TEXT_BYTES=900

# ===== 容错 / 鲁棒性 =====
# LLM 调用超时（秒）与重试次数（火山方舟 SDK 内置指数退避，覆盖 429/5xx/超时）
ARK_LLM_TIMEOUT=60
ARK_LLM_MAX_RETRIES=2
# 结构化 JSON 调用（出题/判题/错因分析）专用：更短超时 + 更少重试，避免前端长时间空等
ARK_JSON_TIMEOUT=45
ARK_JSON_MAX_RETRIES=1
# 结构化输出最大 token 数，限制上限可显著降低"模型越写越长"导致的超时
ARK_JSON_MAX_TOKENS=2048
# 是否对结构化调用关闭深度思考（1=关闭）。深度思考会让出题耗时成倍增加
ARK_DISABLE_THINKING=1
# 传给出题 prompt 的讲解文本最大字符数，避免讲解过长拖慢出题
QUIZ_LESSON_MAX_CHARS=1200
# 会话过期清理：超过该时长无活动自动删除（秒），防止内存无限增长
SESSION_TTL_SECONDS=7200
SESSION_CLEANUP_INTERVAL=600
# 会话数量上限：达到上限时汰汰最久未活动的会话（设 0 表示不限制）
MAX_SESSIONS=500
# 上传的 PDF 会保留以支持左栏预览，超过该时长后清理（秒，设 0 表示不清理）
# PDF 保留时长，默认与会话 TTL 一致（2 小时）；会话都过期了 PDF 留着也无人预览
UPLOAD_TTL_SECONDS=7200
# uploads 目录总容量上限（MB，0=不限）。TTL 只管"放得久"，管不了"来得猛"
UPLOAD_MAX_TOTAL_MB=4096
# anyio 线程池上限。默认 40 在 20 并发下会触顶（实测峰值卡在 40）
THREAD_POOL_SIZE=80
# 应用日志级别
LOG_LEVEL=INFO
