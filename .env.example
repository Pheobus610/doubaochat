# ===== 火山方舟（豆包）大模型 =====
ARK_API_KEY=你的方舟_API_Key
ARK_MODEL=ep-xxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 语音接口（ASR / TTS） =====
# 模式：auto(默认，优先 openspeech)、openspeech、ark
SPEECH_PROVIDER=auto
SPEECH_BASE_URL=https://openspeech.bytedance.com
SPEECH_APPID=
SPEECH_TOKEN=
SPEECH_CLUSTER=volcano_tts

# ===== 服务运行 =====
HOST=0.0.0.0
PORT=8000

# ===== 访问控制（可选，公网暴露时强烈建议开启） =====
# 留空则不启用；设置后，除 /、/static、/api/health 外的接口
# 均需在请求头携带：Authorization: Bearer <ACCESS_TOKEN> 或 X-Access-Token
ACCESS_TOKEN=

# ===== 上传 / TTS 限额 =====
MAX_UPLOAD_MB=50
MAX_AUDIO_MB=25
TTS_VOICE=zh_female_cancan_mars_bigtts
TTS_RATE=1.0
TTS_MAX_TEXT_BYTES=900

# ===== 容错 / 鲁棒性 =====
# LLM 调用超时（秒）与重试次数（火山方舟 SDK 内置指数退避，覆盖 429/5xx/超时）
ARK_LLM_TIMEOUT=60
ARK_LLM_MAX_RETRIES=2
# 会话过期清理：超过该时长无活动自动删除（秒），防止内存无限增长
SESSION_TTL_SECONDS=7200
SESSION_CLEANUP_INTERVAL=600
